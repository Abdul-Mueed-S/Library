<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="PDF Catalogue"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LIBRARIES"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:alpha="0.6"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:id="@+id/libraryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/settings_card_bg"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WHAT TO INCLUDE"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:alpha="0.6"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/settings_card_bg"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="12sp"
                android:alpha="0.7" />
            <Spinner
                android:id="@+id/categorySpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Series"
                android:textSize="12sp"
                android:alpha="0.7" />
            <Spinner
                android:id="@+id/seriesSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox android:id="@+id/includeDraftsCheck" android:text="Include drafts"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
            <CheckBox android:id="@+id/includeDuplicatesCheck" android:text="Include flagged duplicates"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <CheckBox android:id="@+id/onlyFavouritesCheck" android:text="Favourites only"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <CheckBox android:id="@+id/onlyLentCheck" android:text="Lent-out books only"
                android:layout_width="match_parent" android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LAYOUT"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:alpha="0.6"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp"
            android:background="@drawable/settings_card_bg"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Group by"
                android:textSize="12sp"
                android:alpha="0.7" />
            <Spinner
                android:id="@+id/groupSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sort by"
                android:textSize="12sp"
                android:alpha="0.7" />
            <Spinner
                android:id="@+id/sortSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox android:id="@+id/pagePerLibraryCheck" android:text="Start each library on a new page"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="COLUMNS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:alpha="0.6"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:id="@+id/columnContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/settings_card_bg"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/createCatalogueButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create PDF" />

    </LinearLayout>

</ScrollView>