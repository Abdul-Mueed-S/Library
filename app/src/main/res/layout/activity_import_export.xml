<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_revert"
                android:background="?attr/selectableItemBackground"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/pageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/exportSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="EXPORT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:alpha="0.6"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <RadioGroup
                    android:id="@+id/formatGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton android:id="@+id/formatJson" android:text="JSON"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
                    <RadioButton android:id="@+id/formatCsv" android:text="CSV"
                        android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="24dp" />

                </RadioGroup>

                <CheckBox
                    android:id="@+id/includeCategoriesCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Include categories"
                    android:checked="true"
                    android:layout_marginTop="12dp" />

                <CheckBox
                    android:id="@+id/includeFavoritesCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Include favourites"
                    android:checked="true"
                    android:layout_marginTop="4dp" />

                <CheckBox
                    android:id="@+id/includeDuplicateFlagsCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Include duplicate flags"
                    android:checked="false"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Export Library" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/importSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="IMPORT"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:alpha="0.6"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_card_bg"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <CheckBox
                    android:id="@+id/importCategoriesDefaultCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import with categories (default)"
                    android:checked="true" />

                <CheckBox
                    android:id="@+id/importFavoritesDefaultCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import with favourites (default)"
                    android:checked="true"
                    android:layout_marginTop="4dp" />

                <CheckBox
                    android:id="@+id/importDuplicateFlagsDefaultCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Import with duplicate flags (default)"
                    android:checked="false"
                    android:layout_marginTop="4dp" />

                <Button
                    android:id="@+id/importButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Choose File to Import" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/fullBackupSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="FULL BACKUP / RESTORE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:alpha="0.6"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/settings_card_bg"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="A full backup saves your entire library exactly as-is, including internal IDs. Restoring one REPLACES your current library completely — this cannot be undone."
                    android:textSize="12sp"
                    android:alpha="0.7" />

                <Button
                    android:id="@+id/fullBackupButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Create Full Backup" />

                <Button
                    android:id="@+id/fullRestoreButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Restore Full Backup" />

                <Button
                    android:id="@+id/restoreVaultMetadataButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Restore Library Names/Locations" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>