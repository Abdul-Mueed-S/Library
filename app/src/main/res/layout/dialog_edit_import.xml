<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <EditText android:id="@+id/editTitleInput" android:hint="Title *"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/editAuthorInput" android:hint="Author"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/editEditionInput" android:hint="Edition"
        android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/editYearInput" android:hint="Year"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
    <EditText android:id="@+id/editIsbnInput" android:hint="ISBN"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
    <EditText android:id="@+id/editCategoryInput" android:hint="Category"
        android:layout_width="match_parent" android:layout_height="wrap_content" />

</LinearLayout>